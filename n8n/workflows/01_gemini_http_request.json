{
  "name": "01 - Gemini Flash Direct HTTP Automation",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "gemini-generate",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "11111111-0001-4000-8000-000000000001",
      "name": "Webhook Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 300]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "param-prompt",
              "name": "prompt",
              "value": "={{ $json.body.prompt || 'Explain how AI works in a few words' }}",
              "type": "string"
            },
            {
              "id": "param-source",
              "name": "source",
              "value": "n8n-automation",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "11111111-0001-4000-8000-000000000002",
      "name": "Prepare Payload",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [460, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://generativelanguage.googleapis.com/v1beta/models/gemini-flash-latest:generateContent",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "X-goog-api-key",
              "value": "={{ $env.GEMINI_API_KEY }}"
            }
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={\n  \"contents\": [\n    {\n      \"parts\": [\n        {\n          \"text\": \"{{ $json.prompt }}\"\n        }\n      ]\n    }\n  ]\n}",
        "options": {
          "timeout": 15000
        }
      },
      "id": "11111111-0001-4000-8000-000000000003",
      "name": "HTTP Request - Gemini API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [680, 300]
    },
    {
      "parameters": {
        "jsCode": "// Extract generated text from Gemini API response\nconst response = $input.first().json;\nlet generatedText = 'No text generated';\n\nif (response.candidates && response.candidates.length > 0) {\n  const parts = response.candidates[0].content?.parts || [];\n  generatedText = parts.map(p => p.text).join('');\n}\n\nreturn [{\n  json: {\n    success: true,\n    model: 'gemini-flash-latest',\n    prompt: $('Prepare Payload').first().json.prompt,\n    generatedText: generatedText,\n    usageMetadata: response.usageMetadata || {},\n    timestamp: new Date().toISOString()\n  }\n}];"
      },
      "id": "11111111-0001-4000-8000-000000000004",
      "name": "Format Gemini Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [900, 300]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify($json) }}",
        "options": {}
      },
      "id": "11111111-0001-4000-8000-000000000005",
      "name": "Respond to Webhook",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [1120, 300]
    }
  ],
  "connections": {
    "Webhook Trigger": {
      "main": [
        [
          {
            "node": "Prepare Payload",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Prepare Payload": {
      "main": [
        [
          {
            "node": "HTTP Request - Gemini API",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "HTTP Request - Gemini API": {
      "main": [
        [
          {
            "node": "Format Gemini Response",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Format Gemini Response": {
      "main": [
        [
          {
            "node": "Respond to Webhook",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "versionId": "11111111-0001-4000-8000-000000000000",
